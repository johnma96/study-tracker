# Cadena de conexion de Neon Postgres.
# Obtenla en el panel de Neon. NUNCA la versiones con el valor real.
DATABASE_URL=postgres://usuario:clave@host.neon.tech/study_tracker?sslmode=require

# Zona horaria de referencia para agrupar por dia (RF-00).
TZ=America/Bogota

# Rebanada R6 (autenticacion). Aun no se usan.
# AUTH_SECRET=
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
# ALLOWED_EMAILS=tu-correo@ejemplo.com
