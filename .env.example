# Cadena de conexion de Neon Postgres, branch de DESARROLLO.
# Obtenla en el panel de Neon. NUNCA la versiones con el valor real.
#
# Mismo nombre de variable en todos los entornos, valor distinto en cada uno:
#   local  -> branch 'dev'
#   Vercel -> branch principal (definido en Settings > Environment Variables)
#
# La cadena de produccion NO debe estar en este archivo. Vive solo en Vercel.
# Si tienes ambas localmente, tarde o temprano corres una migracion contra la
# que no era.
DATABASE_URL=postgres://usuario:clave@host.neon.tech/study_tracker?sslmode=require

# Zona horaria de referencia para agrupar por dia (RF-00).
# NO la llames TZ: Vercel reserva ese nombre porque es una variable de sistema
# que fija la zona horaria del runtime de Node, y rechaza el despliegue.
APP_TIMEZONE=America/Bogota

# Rebanada R6 (autenticacion). Aun no se usan.
# AUTH_SECRET=
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
# ALLOWED_EMAILS=tu-correo@ejemplo.com
